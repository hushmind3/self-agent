{
  "name": "autonomous-agent-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "paperclip:dev": "pnpm --filter paperclip dev",
    "paperclip:onboard": "pnpm --filter paperclipai dev onboard",
    "hermes": ".venv/Scripts/hermes.exe",
    "hermes:install": "node -e \"const {spawnSync}=require('node:child_process');const {resolve}=require('node:path');process.exit(spawnSync('uv',['sync','--project','Hermes','--locked','--no-dev'],{stdio:'inherit',env:{...process.env,UV_PROJECT_ENVIRONMENT:resolve('.venv')}}).status??1)\"",
    "paperclip:prepare": "pnpm --filter @paperclipai/plugin-sdk build && pnpm --filter @paperclipai/paperclip-runner build:typescript && pnpm --filter @paperclipai/ui build",
    "paperclip:start": "node paperclip-start.cjs",
    "hermes:dashboard": ".venv/Scripts/hermes.exe dashboard --no-open"
  },
  "pnpm": {
    "patchedDependencies": {
      "embedded-postgres@18.1.0-beta.16": "Paperclip/patches/embedded-postgres@18.1.0-beta.16.patch",
      "acpx@0.12.0": "Paperclip/patches/acpx@0.12.0.patch",
      "acpx@0.13.1": "Paperclip/patches/acpx@0.13.1.patch",
      "@agentclientprotocol/claude-agent-acp@0.73.0": "Paperclip/patches/@agentclientprotocol__claude-agent-acp@0.73.0.patch",
      "@agentclientprotocol/codex-acp@1.6.2": "Paperclip/patches/@agentclientprotocol__codex-acp@1.6.2.patch",
      "@chat-adapter/telegram@4.39.0": "Paperclip/patches/@chat-adapter__telegram@4.39.0.patch",
      "@chat-adapter/teams@4.39.0": "Paperclip/patches/@chat-adapter__teams@4.39.0.patch",
      "@chat-adapter/slack@4.39.0": "Paperclip/patches/@chat-adapter__slack@4.39.0.patch",
      "@chat-adapter/discord@4.39.0": "Paperclip/patches/@chat-adapter__discord@4.39.0.patch",
      "@chat-adapter/github@4.39.0": "Paperclip/patches/@chat-adapter__github@4.39.0.patch",
      "@discordjs/ws@1.2.3": "Paperclip/patches/@discordjs__ws@1.2.3.patch",
      "postgres@3.4.9": "Paperclip/patches/postgres@3.4.9.patch"
    },
    "overrides": {
      "@agentclientprotocol/codex-acp@1.6.2>@openai/codex": "0.160.0",
      "@agentclientprotocol/claude-agent-acp@0.73.0>@anthropic-ai/claude-agent-sdk": "0.3.286",
      "rollup": ">=4.59.0",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "@codemirror/state": "^6.7.2",
      "@codemirror/view": "^6.43.11",
      "@lezer/common": "^1.5.2"
    }
  }
}
